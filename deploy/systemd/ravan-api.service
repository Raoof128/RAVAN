[Unit]
Description=RAVAN private cinema API
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/ravan-prepared
[Service]
Type=simple
User=ravan
Group=ravan
WorkingDirectory=/opt/ravan/current
EnvironmentFile=/etc/ravan/ravan.env
ExecStart=/opt/ravan/runtimes/node-v24.22.3-linux-x64/bin/node dist/apps/api/src/main.js
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PATH=/opt/ravan/runtimes/node-v24.22.3-linux-x64/bin:/usr/bin:/bin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=true
ProtectProc=invisible
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ravan /var/lib/ravan-prepared
MemoryMax=768M
CPUQuota=100%
TasksMax=64
KillMode=control-group
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
