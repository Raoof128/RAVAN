[Unit]
Description=RAVAN encrypted metadata backup
After=ravan-api.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ravan/current
EnvironmentFile=/etc/ravan/backup.env
ExecStart=/opt/ravan/runtimes/node-v24.22.3-linux-x64/bin/node scripts/scheduled-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ravan /var/lib/ravan
MemoryMax=384M
CPUQuota=25%
TimeoutStartSec=120
