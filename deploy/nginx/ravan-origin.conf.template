# Dedicated DNS-only origin. Substitute the hostname, certificate paths and
# 32-byte hex origin key privately. Never commit the rendered configuration.
map $http_x_ravan_origin_key $ravan_edge_authorized {
    default 0;
    ~^__ORIGIN_KEY__$ 1;
}
server {
    listen 80;
    server_name __ORIGIN_HOST__;
    access_log off;
    error_log /dev/null crit;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/ravan-acme; }
    location / { return 404; }
}
server {
    listen 443 ssl;
    server_name __ORIGIN_HOST__;
    ssl_certificate __CERTIFICATE_PATH__;
    ssl_certificate_key __CERTIFICATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 64k;
    client_body_timeout 15s;
    send_timeout 40s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control no-store always;
    # Port 80 on this host serves only the ACME challenge.
    add_header Strict-Transport-Security "max-age=31536000" always;
    location ~ ^/_worker { return 404; }
    location ^~ /media/ {
        # Decide on the path as it was written. This location is chosen from
        # the path with ".." and "%2F" resolved, but the request is passed on
        # unchanged: "/api/x/..%2f..%2fmedia/y" entered here and reached the
        # API, and "/_worker/...", without the origin key.
        if ($request_uri !~ "^/media/s/[A-Za-z0-9_-]+/[A-Za-z0-9][A-Za-z0-9._-]*(\?.*)?$") { return 404; }
        if ($request_method !~ ^(GET|HEAD|OPTIONS)$) { return 405; }
        if ($request_method = OPTIONS) { return 204; }
        add_header Access-Control-Allow-Origin "https://cinema.example.com" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Range" always;
        add_header Access-Control-Expose-Headers "Content-Range, Accept-Ranges, Content-Length" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control no-store always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Cookie "";
        proxy_set_header X-Ravan-Origin-Key "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Ravan-Client-IP "";
        proxy_hide_header Set-Cookie;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 40s;
    }
    location ~ ^/(api|auth)/ {
        if ($ravan_edge_authorized = 0) { return 403; }
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Ravan-Origin-Key "";
        proxy_set_header X-Forwarded-For $http_x_ravan_client_ip;
        proxy_set_header X-Ravan-Client-IP "";
        proxy_buffering off;
        proxy_read_timeout 25s;
    }
    location = /readyz {
        if ($ravan_edge_authorized = 0) { return 403; }
        proxy_pass http://127.0.0.1:4310;
        proxy_set_header X-Ravan-Origin-Key "";
        proxy_set_header X-Forwarded-For $http_x_ravan_client_ip;
        proxy_set_header X-Ravan-Client-IP "";
    }
    location / { return 404; }
}
