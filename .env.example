# Copy to .env locally. Never commit the populated file.
NODE_ENV=development
PORT=4310
MOV_ORIGIN=http://localhost:5173
MOV_DATA_DIR=.local/data
# Optional: set an absolute real directory to enable browser conversion.
# Production requires the separate bounded preparation filesystem.
# MOV_PREPARED_DIR=/absolute/path/to/prepared
# Local development only. Production enforces at least 30 GiB.
MOV_MIN_FREE_BYTES=1073741824
# Optional. Encoder speed preset (default superfast) and thread count
# (default: one per available CPU, at most 4).
# MOV_ENCODER_PRESET=superfast
# MOV_ENCODER_THREADS=2
# Optional. "hls" (default) lets the web player watch a film while it is still
# being prepared; "mp4" writes one file that plays only when finished.
# MOV_PREPARED_FORMAT=hls
# Optional. Size of the prepared filesystem in bytes (default 20 GiB).
# MOV_PREPARED_CAPACITY_BYTES=21474836480
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOV_OWNER_SUBJECT=
MOV_ENCRYPTION_KEY=
MOV_WORKER_KEY=
# Optional. TMDB API Read Access Token (themoviedb.org, account settings, API).
# When set, the server sends each film's title and year to TMDB to find a
# poster and backdrop. Unset, every picture is made from the films themselves.
# MOV_TMDB_TOKEN=
