# Copy to .env locally. Never commit the populated file.
NODE_ENV=development
PORT=4310
MOV_ORIGIN=http://localhost:5173
MOV_DATA_DIR=.local/data
# Optional: set an absolute real directory to enable browser conversion.
# Production requires the separate bounded preparation filesystem.
# MOV_PREPARED_DIR=/absolute/path/to/prepared
# Local development only. Production enforces at least 30 GiB.
MOV_MIN_FREE_BYTES=1073741824
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOV_OWNER_SUBJECT=
MOV_ENCRYPTION_KEY=
MOV_WORKER_KEY=
