    "%@ · Source unavailable": {
      "localizations": {
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Source unavailable"
          }
        }
      }
    },
    "%lld%% prepared": {
      "localizations": {
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% prepared"
          }
        }
      }
    },
    "A connected server receives the device name you enter, catalogue and playback requests, and viewing progress. Saving a server film updates that server’s watchlist. Its operator controls retention and access. RAVĀN keeps its device credential in the system Keychain. Disconnect in Your Cinema to remove this device’s saved access.": {
      "localizations": {
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A connected server receives the device name you enter, catalogue and playback requests, and viewing progress. Saving a server film updates that server’s watchlist. Its operator controls retention and access. RAVĀN keeps its device credential in the system Keychain. Disconnect in Your Cinema to remove this device’s saved access."
          }
        }
      }
    },
    "A study of the shore at first light, told in three tides.": {
      "localizations": {
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A study of the shore at first light, told in three tides."
          }
        }
      }
    },
    "Access to the file has changed. Use Locate file to grant access again.": {
      "localizations": {
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to the file has changed. Use Locate file to grant access again."
          }
        }
