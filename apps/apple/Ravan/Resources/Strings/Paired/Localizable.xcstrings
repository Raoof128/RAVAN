    },
    "Access was removed from this device. Open Your Cinema in the owner’s browser to revoke the device on the server.": {
      "localizations": {
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Access was removed from this device. Open Your Cinema in the owner’s browser to revoke the device on the server."
